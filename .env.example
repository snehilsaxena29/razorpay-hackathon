# Copy to .env for local use. .env is gitignored and must never be committed.
#
# Every variable below is OPTIONAL. With none of them set, `make demo` still runs:
# it falls back to REPLAY mode using the recorded cassettes in fixtures/cassettes/.

# Enables LIVE mode. Without it the harness replays cassettes.
GROQ_API_KEY=

# Model ids get retired. Verify with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GAUNTLET_MODEL=llama-3.3-70b-versatile

# auto | live | replay.  auto = live if a key is present, else replay.
# `live` with no key is a fatal config error (exit 3), not a silent downgrade.
GAUNTLET_MODE=auto

GAUNTLET_LLM_TIMEOUT_S=20
GAUNTLET_MAX_RETRIES=3
GAUNTLET_BREAKER_THRESHOLD=3
GAUNTLET_EPISODE_TIMEOUT_S=60
GAUNTLET_OUT_DIR=./runs
GAUNTLET_LOG_LEVEL=INFO
